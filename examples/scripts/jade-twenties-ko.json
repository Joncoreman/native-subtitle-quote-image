{
  "lines": [
    {
      "t": 22.4,
      "text": "20대에는 많은 것을 가질 수 있어요"
    },
    {
      "t": 25.0,
      "text": "하지만 전부를 동시에 가질 수는 없어요"
    },
    {
      "t": 28.7,
      "text": "커리어와 돈, 여행과 사랑"
    },
    {
      "t": 31.4,
      "text": "친구와 가족, 자유와 성장"
    },
    {
      "t": 40.8,
      "text": "당신이 뒤처진 게 아니라"
    },
    {
      "t": 51.6,
      "text": "삶이 한꺼번에 펼쳐지지 않을 뿐이에요"
    }
  ]
}
