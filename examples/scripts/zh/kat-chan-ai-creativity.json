  "lines": [
    {
      "t": 3503.2,
      "text": "卡住的时候，人工智能能帮你起步"
    },
    {
      "t": 3518.0,
      "text": "但它通常不擅长给出最终创意"
    },
    {
      "t": 3528.8,
      "text": "人工智能像是在把一切拉平"
    },
    {
      "t": 3543.0,
      "text": "好创意恰恰要偏离平均值"
    },
    {
      "t": 3546.7,
      "text": "这就需要人的头脑"
    }
  ]
}
